# .gitignore for analog.quest

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python lib directories (but not Next.js lib)
/venv/lib/
/venv/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
env/
ENV/

# Database backups (keep schema, ignore data backups)
database/backup/*.db
database/*.db-journal
database/*.db-wal

# Keep the main database in git (it's the core data)
# Uncomment this if database gets too large:
# database/papers.db

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Claude Code specific
.claude/cache/
.claude/sessions/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Downloaded papers (if we cache PDFs)
papers_cache/
*.pdf

# Python virtual environment
.venv/

# Next.js
.next/
out/
node_modules/
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Environment variables
.env.local
.env.production
# Temporary backups (critical data backed up elsewhere)
backups/

# Keep archive structure but can ignore contents for now
archive/**/*.json
archive/**/*.json.gz
archive/**/*.py

# But keep directory structure
!archive/sessions/
!archive/scripts/
!archive/large_files/
!archive/sessions/*/


# Local agent notes (never commit)
AGENT-ORIENT.local.md
